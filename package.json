{
  "name": "react-native-stylized",
  "version": "0.2.0",
  "description": "Modern styling library for React Native with conditional styling and global theming",
  "homepage": "https://github.com/MichelGutner/stylized#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/MichelGutner/stylized.git"
  },
  "bugs": {
    "url": "https://github.com/MichelGutner/stylized/issues"
  },
  "keywords": [
    "react-native",
    "styling",
    "theme",
    "typescript",
    "styled-components",
    "css-in-js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tspc -p tsconfig.json",
    "lint:fix": "yarn lint --fix",
    "lint": "yarn --lint",
    "test": "jest",
    "build:dev": "yarn build && yalc push",
    "build:watch": "./watch.sh",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.70"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/gitlab": "^13.2.4",
    "@testing-library/react": "^14.0.0",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@babel/core": "^7.25.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "eslint": "^9.21.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "metro-react-native-babel-preset": "^0.77.0",
    "react-test-renderer": "^19.0.0",
    "semantic-release": "^24.2.3",
    "ts-jest": "^29.2.6",
    "ts-patch": "^3.3.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.26.0",
    "typescript-transform-paths": "^3.5.3",
    "react": "^19.1.0",
    "react-native": "^0.81.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./react-native": {
      "types": "./dist/react-native/index.d.ts",
      "import": "./dist/react-native/index.js",
      "require": "./dist/react-native/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://www.npmjs.com/package/react-native-stylized"
  },
  "sideEffects": false,
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/babel.config.*",
    "!dist/**/jest.config.*",
    "README.md",
    "LICENSE"
  ]
}