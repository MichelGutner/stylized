{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "declaration": true,
    "declarationMap": true,
    "removeComments": false,
    "preserveSymlinks": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": true,
    "outDir": "./dist",
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "plugins": [
      { "transform": "typescript-transform-paths", "afterDeclarations": true }
    ],
    "types": ["jest", "node"],
    "lib": ["esnext", "dom"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "example", "**/__tests__/*", "**/__mocks__/*"]
}
